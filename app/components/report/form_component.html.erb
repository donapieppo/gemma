<div class="row">
  <div class="col-sm-4">
    <%= render DmUniboCommon::CardComponent.new(title: "Reports") do %>
      <ul class="list-group list-group-flush" id="choose_report">
        <%= link_to "Elenco articoli",      reports_form_articoli_path,    class: "list-group-item list-group-item-action" %>
        <%= link_to "Giacenze attuali",     reports_form_giacenza_path,    class: "list-group-item list-group-item-action" %>
        <%= link_to "Articoli sottoscorta", reports_form_sottoscorta_path, class: "list-group-item list-group-item-action" %>
        <%= link_to "Storico movimenti",    reports_form_storico_path,     class: "list-group-item list-group-item-action" %>
        <%= link_to "Scarichi utente",      reports_form_scarichi_path,    class: "list-group-item list-group-item-action" %>
        <%= link_to "Ricevute scarichi",    reports_form_receipts_path,    class: "list-group-item list-group-item-action" %>
        <%= link_to "Dettagli Ddt",         reports_form_ddts_path,        class: "list-group-item list-group-item-action" %>
      </ul>

      <div class="my-4">
        <%= link_to 'archivio anni passati', archs_path, class: :button%>
      </div>

      <div class="alert alert-info">
        Il formato csv <i class="fa-regular fa-file-excel fa-xl"></i> può essere importato in excel, openoffice calc o anche solo salvato come file di testo.
      </div>
    <% end %>
  </div>
  <div class="col-sm-8">
    <%= render DmUniboCommon::CardComponent.new(title: @title) do %>
      <%= content %>
    <% end %>
  </div>
</div>
