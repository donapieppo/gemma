<h1><%= booking_title %></h1>

<div class="alert alert-info">
  Da questa pagina è possibile consultare e cancellare le proprie prenotazioni.
</div>

<div class="bookings-list my-3">
  <% @books.each do |booking|  %>  
    <%= content_tag :div, class: "bookings-list-item #{booking.class}" do %>
      <div class="row ">
        <div class="col-2 col-lg-1">
          <div class="move-number py-1 px-2"><%= booking.number.abs %></div>
        </div>

        <div class="col">
          <div>
            <span class="pe-2"><%= l booking.date %></span>
            <span class="font-weight-bold"><%= booking.thing %></span>
            <small class="text-body-secondary">da <%= booking.moves.first.deposit.location %></small>
            <span class="float-end">
              <%= link_to_delete "", booking_path(booking) %>
            </span>
          </div>
          <div>
            <% if booking.recipient_id %>
              Responsabile: <strong><%= booking.recipient %></strong>
            <% end %>
            <% if (cost_center = booking.cost_center) %>
              <%= dm_icon "coins", text: cost_center.to_s %> &nbsp;
            <% end %>
            <% if (pp = booking.picking_point) %>
              <%= dm_icon "house", text: pp.to_s %> &nbsp;
            <% end %>
            <% if (lab = booking.lab) %>
              <%= dm_icon "flask", text: "Lab #{lab}" %>
            <% end %>
          </div>
          <% unless booking.note.blank? %>
            <div class="ps-4 text-muted">
              note: <%= booking.note %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
