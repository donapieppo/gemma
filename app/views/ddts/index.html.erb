<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1>
    DDT/Fatture
    <%= @supplier ? "di #{@supplier}" : '' %>  
    <% if @titolo_ricerca %> 
      <small>(<%= @titolo_ricerca %>)</small>
    <% end %>
  </h1>
  <div>
    <%= link_to_new 'Registra nuovo ddt/fattura', suppliers_path(for: 'ddt') %>
  </div>
</div>


<div class="row">
  <div class="col-md-3">
    <%= render Ddt::SearchMenuComponent.new(current_organization) %>
  </div>

  <div class="col-md-9">
    <%= render Ddt::TableComponent.new(@ddts, current_user) %>  
  </div>
</div>

