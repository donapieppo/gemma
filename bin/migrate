#!/bin/bash

( hostname -f | grep -q 'cesia-pd-fisso' ) || exit 0

ssh donatini.adm@railsdb-01 "mysqldump gemma" > tmp/dump.mysql

( hostname -f | grep -q 'cesia-pd-fisso' ) && mysql -e 'drop database gemma; create database gemma'
( hostname -f | grep -q 'cesia-pd-fisso' ) && mysql gemma < tmp/dump.mysql

mysql gemma -e "update users set email=upn"

( hostname -f | grep -q 'cesia-pd-fisso' ) && mysql gemma < doc/changes.sql
( hostname -f | grep -q 'cesia-pd-fisso' ) && ./bin/rails db:schema:dump

